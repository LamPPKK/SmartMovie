    "Open a title on your iPhone to start controlling it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneで作品を開くと操作を開始できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "iPhone에서 작품을 열어 제어를 시작하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mở một tựa phim trên iPhone để bắt đầu điều khiển." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 iPhone 上打开一个影视条目即可开始控制。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 iPhone 上開啟一個影視項目即可開始控制。" } }
